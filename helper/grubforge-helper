#!/usr/bin/python3
"""
grubForge — privileged helper

Runs as root via pkexec. grubForge itself always runs as your user; when it
needs to change something under /etc or /boot, it calls this helper and polkit
asks you to authenticate. The password goes to polkit, never to grubForge.

The contract that makes this safe: this helper accepts a FIXED VOCABULARY of
verbs. It will not run a command you hand it. If it did, it would be a way to
run anything as root, which is the exact problem it exists to avoid.

Deliberately self-contained — stdlib only, no imports from the grubforge
package. Root-owned code must never import code from a user-writable path.

Usage:
    grubforge-helper <verb> [argument]

Verbs:
    write-config             read /etc/default/grub content from stdin
    write-custom-40          read /etc/grub.d/40_custom content from stdin
    regenerate               run grub-mkconfig -o /boot/grub/grub.cfg
    backup-create [label]    snapshot /etc/default/grub, rotate old ones
    backup-restore <name>    restore a named backup (auto-snapshots first)
    backup-delete <name>     delete a named backup
    script-enable <name>     restore execute permission on a grub.d script
    script-disable <name>    remove execute permission from a grub.d script
    os-prober-run            scan for other installed operating systems

Exit status is 0 on success. Anything else means nothing was changed, and the
reason is on stderr.
"""

import os
import re
import stat
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

# ── Constants — must stay in step with the grubforge package ──────────────────

GRUB_CONFIG_PATH = Path("/etc/default/grub")
GRUB_D_PATH      = Path("/etc/grub.d")
CUSTOM_40        = GRUB_D_PATH / "40_custom"
GRUB_CFG_PATH    = Path("/boot/grub/grub.cfg")
BACKUP_DIR       = Path("/var/lib/grubforge/backups")

MAX_BACKUPS   = 10
BACKUP_PREFIX = "grub_"
BACKUP_SUFFIX = ".bak"
_TS_FORMAT    = "%Y%m%d_%H%M%S_%f"

# The only scripts this helper will ever touch. An enumeration, not a pattern —
# mirrors MANAGED_SCRIPTS in grubforge/boot_entries_manager.py.
MANAGED_SCRIPTS = ["10_linux", "20_linux_xen", "30_os-prober", "30_uefi-firmware"]

# Backup filenames are generated by us and have exactly one shape.
_BACKUP_RE = re.compile(r"^grub_\d{8}_\d{6}_\d{6}\.bak$")

# Every meaningful line of /etc/default/grub is SHELL_STYLE=value.
_GRUB_KEY_RE = re.compile(r"^[A-Z_][A-Z0-9_]*=")

# Generous next to a ~1 KB config, small enough that nothing can flood /etc.
MAX_INPUT_BYTES = 1024 * 1024

# pkexec gives us a sanitised environment; be explicit anyway.
SAFE_ENV = {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "LC_ALL": "C",
}


# ── Failure ───────────────────────────────────────────────────────────────────

def die(message: str, code: int = 1) -> None:
    """Report why nothing happened, and stop."""
    print(f"grubforge-helper: {message}", file=sys.stderr)
    sys.exit(code)


# ── Input validation ──────────────────────────────────────────────────────────

def read_stdin_content() -> str:
    """Read the file content to be written, with a size ceiling."""
    raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
    if len(raw) > MAX_INPUT_BYTES:
        die(f"input larger than {MAX_INPUT_BYTES} bytes — refusing")
    if not raw:
        die("no content on stdin")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        die("input is not valid UTF-8")


def validate_grub_config(content: str) -> None:
    """
    Every non-blank, non-comment line must look like KEY=value.

    This stops the verb being used to write arbitrary text into /etc/default/grub.
    grub-mkconfig sources that file as shell, so 'arbitrary text' would mean
    'arbitrary code as root'.
    """
    for number, line in enumerate(content.splitlines(), start=1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if not _GRUB_KEY_RE.match(stripped):
            die(f"line {number} is not a KEY=value setting — refusing to write")


def validate_custom_40(content: str) -> None:
    """40_custom is a shell script GRUB runs; require the shape GRUB expects."""
    if not content.startswith("#!/bin/sh"):
        die("40_custom must begin with #!/bin/sh — refusing to write")


def validated_backup_path(name: str) -> Path:
    """
    Turn a caller-supplied backup name into a path we are willing to touch.

    Three separate checks, because this is the one verb that takes a filename:
    the name must have our exact generated shape, must not contain a path at
    all, and must still resolve inside the backup directory once symlinks are
    followed. Without the last one, a symlink planted in the backup directory
    could redirect a delete anywhere on the system.
    """
    if not _BACKUP_RE.match(name):
        die(f"{name!r} is not a grubForge backup name")

    if Path(name).name != name:
        die("backup name must not contain a path")

    candidate = BACKUP_DIR / name
    try:
        resolved = candidate.resolve(strict=True)
    except FileNotFoundError:
        die(f"no such backup: {name}")

    if resolved.parent != BACKUP_DIR.resolve():
        die("backup resolves outside the backup directory — refusing")

    return resolved


def validated_script(name: str) -> Path:
    """Only the four scripts grubForge manages, by exact name."""
    if name not in MANAGED_SCRIPTS:
        die(f"{name!r} is not a script grubForge manages")

    script = GRUB_D_PATH / name
    if not script.is_file():
        die(f"{name} is not installed on this system")

    return script


def validated_label(label: str) -> str:
    """A short, printable, single-line note attached to a backup."""
    cleaned = "".join(c for c in label if c.isprintable()).strip()
    return cleaned[:64]


# ── Writing ───────────────────────────────────────────────────────────────────

def atomic_write(path: Path, content: str, default_mode: int) -> None:
    """
    Write via a temporary file in the same directory, then rename over the
    target. A rename is atomic, so an interrupted write can never leave a
    half-written /etc/default/grub — which would be an unbootable machine.
    """
    path.parent.mkdir(parents=True, exist_ok=True)

    mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else default_mode

    fd, temp_name = tempfile.mkstemp(dir=str(path.parent), prefix=".grubforge-")
    temp = Path(temp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp, mode)
        os.chown(temp, 0, 0)
        os.replace(temp, path)
    except Exception:
        temp.unlink(missing_ok=True)
        raise

    # Ensure the rename itself reaches disk.
    dir_fd = os.open(str(path.parent), os.O_RDONLY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def label_path(backup: Path) -> Path:
    """Mirrors _label_path() in backup_manager.py: grub_X.bak -> grub_X.bak.label"""
    return backup.with_suffix(backup.suffix + ".label")


# ── Verbs ─────────────────────────────────────────────────────────────────────

def do_write_config() -> None:
    content = read_stdin_content()
    validate_grub_config(content)
    atomic_write(GRUB_CONFIG_PATH, content, default_mode=0o644)
    print(f"wrote {GRUB_CONFIG_PATH}")


def do_write_custom_40() -> None:
    content = read_stdin_content()
    validate_custom_40(content)
    atomic_write(CUSTOM_40, content, default_mode=0o755)
    current = CUSTOM_40.stat().st_mode
    CUSTOM_40.chmod(current | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"wrote {CUSTOM_40}")


def do_regenerate() -> None:
    try:
        result = subprocess.run(
            ["grub-mkconfig", "-o", str(GRUB_CFG_PATH)],
            capture_output=True, text=True, timeout=60, env=SAFE_ENV,
        )
    except FileNotFoundError:
        die("grub-mkconfig not found — is GRUB installed?")
    except subprocess.TimeoutExpired:
        die("grub-mkconfig timed out after 60 seconds")

    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)


def do_backup_create(label: str = "") -> None:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(BACKUP_DIR, 0o755)

    if not GRUB_CONFIG_PATH.exists():
        die(f"{GRUB_CONFIG_PATH} does not exist — nothing to back up")

    stamp = datetime.now().strftime(_TS_FORMAT)
    dest  = BACKUP_DIR / f"{BACKUP_PREFIX}{stamp}{BACKUP_SUFFIX}"

    shutil.copy2(GRUB_CONFIG_PATH, dest)
    os.chown(dest, 0, 0)

    cleaned = validated_label(label)
    if cleaned:
        sidecar = label_path(dest)
        sidecar.write_text(cleaned, encoding="utf-8")
        os.chown(sidecar, 0, 0)
        os.chmod(sidecar, 0o644)

    rotate_backups()
    print(dest.name)


def rotate_backups() -> None:
    """Keep the newest MAX_BACKUPS snapshots; drop the rest with their labels."""
    existing = sorted(
        BACKUP_DIR.glob(f"{BACKUP_PREFIX}*{BACKUP_SUFFIX}"),
        reverse=True,
    )
    for old in existing[MAX_BACKUPS:]:
        old.unlink(missing_ok=True)
        label_path(old).unlink(missing_ok=True)


def do_backup_restore(name: str) -> None:
    source = validated_backup_path(name)

    # Snapshot what is there now, so restoring is itself undoable.
    if GRUB_CONFIG_PATH.exists():
        do_backup_create_quiet(label="auto (pre-restore)")

    content = source.read_text(encoding="utf-8")
    validate_grub_config(content)
    atomic_write(GRUB_CONFIG_PATH, content, default_mode=0o644)
    print(f"restored {name}")


def do_backup_create_quiet(label: str = "") -> None:
    """backup-create without printing — used inside restore."""
    stamp = datetime.now().strftime(_TS_FORMAT)
    dest  = BACKUP_DIR / f"{BACKUP_PREFIX}{stamp}{BACKUP_SUFFIX}"
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copy2(GRUB_CONFIG_PATH, dest)
    os.chown(dest, 0, 0)
    cleaned = validated_label(label)
    if cleaned:
        sidecar = label_path(dest)
        sidecar.write_text(cleaned, encoding="utf-8")
        os.chown(sidecar, 0, 0)
        os.chmod(sidecar, 0o644)
    rotate_backups()


def do_backup_delete(name: str) -> None:
    target = validated_backup_path(name)
    target.unlink(missing_ok=True)
    label_path(target).unlink(missing_ok=True)
    print(f"deleted {name}")


def do_script_disable(name: str) -> None:
    script = validated_script(name)

    perm_backup = script.with_suffix(".grubforge_perms")
    if not perm_backup.exists():
        perm_backup.write_text(oct(script.stat().st_mode), encoding="utf-8")
        os.chown(perm_backup, 0, 0)
        os.chmod(perm_backup, 0o644)

    current = script.stat().st_mode
    script.chmod(current & ~stat.S_IXUSR & ~stat.S_IXGRP & ~stat.S_IXOTH)
    print(f"disabled {name}")


def do_script_enable(name: str) -> None:
    script = validated_script(name)

    perm_backup = script.with_suffix(".grubforge_perms")
    if perm_backup.exists():
        try:
            original = int(perm_backup.read_text().strip(), 8)
            script.chmod(stat.S_IMODE(original))
            perm_backup.unlink()
            print(f"enabled {name}")
            return
        except (ValueError, OSError):
            pass

    current = script.stat().st_mode
    script.chmod(current | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    print(f"enabled {name}")


def do_os_prober_run() -> None:
    try:
        result = subprocess.run(
            ["os-prober"],
            capture_output=True, text=True, timeout=30, env=SAFE_ENV,
        )
    except FileNotFoundError:
        die("os-prober is not installed")
    except subprocess.TimeoutExpired:
        die("os-prober timed out after 30 seconds")

    sys.stdout.write(result.stdout)
    sys.exit(result.returncode)


# ── Entry point ───────────────────────────────────────────────────────────────

# Verb -> (handler, takes_argument, argument_required)
VERBS = {
    "write-config":    (do_write_config,     False, False),
    "write-custom-40": (do_write_custom_40,  False, False),
    "regenerate":      (do_regenerate,       False, False),
    "backup-create":   (do_backup_create,    True,  False),
    "backup-restore":  (do_backup_restore,   True,  True),
    "backup-delete":   (do_backup_delete,    True,  True),
    "script-enable":   (do_script_enable,    True,  True),
    "script-disable":  (do_script_disable,   True,  True),
    "os-prober-run":   (do_os_prober_run,    False, False),
}


def main() -> None:
    if os.geteuid() != 0:
        die("must run as root — grubForge invokes this through pkexec", code=2)

    if len(sys.argv) < 2:
        die(f"expected a verb, one of: {', '.join(sorted(VERBS))}", code=2)

    verb = sys.argv[1]
    if verb not in VERBS:
        die(f"unknown verb {verb!r} — refusing", code=2)

    handler, takes_arg, arg_required = VERBS[verb]
    extra = sys.argv[2:]

    if len(extra) > 1 or (extra and not takes_arg):
        die(f"{verb} takes {'one argument' if takes_arg else 'no arguments'}", code=2)

    if arg_required and not extra:
        die(f"{verb} requires an argument", code=2)

    try:
        handler(*extra) if takes_arg else handler()
    except PermissionError as exc:
        die(f"permission denied: {exc}")
    except OSError as exc:
        die(str(exc))


if __name__ == "__main__":
    main()
